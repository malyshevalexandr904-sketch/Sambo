// SAMBO DIGITAL ECOSYSTEM — схема БД (DATABASE.md).
// Phase 2: Identity & Access (3.1), Organizations (3.2), Platform (3.9), справочники Phase 2 (API.md, 3.7).
// Phase 3: People (3.3), Rules & Setup — правила и категории (3.4), документы (3.5), ImportJob (3.9).
// Phase 4a: турнир, место, категории турнира и правила допуска (3.4), заявки и участия (3.5),
// право записи и журнал синхронизации (3.9, 7).
// Phase 4b: допуск, прибытие, взвешивание, медицинский допуск (3.5), уведомления (3.8).
// Phase 5a: жеребьёвка, сетки и схватки сеток (3.6).
// Конструкции, которые Prisma не выражает (partial unique, CHECK, генерируемые колонки, партиции,
// REVOKE), пишутся SQL-шагами в миграциях (DATABASE.md, 10). Миграции пишутся и ревьюятся вручную.

generator client {
  provider        = "prisma-client-js"
  // Клиент генерируется внутрь пакета: так его забирает `pnpm deploy` в Docker-образы.
  output          = "../generated/client"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_ADMIN_URL")
  extensions = [citext, pg_trgm]
}

// ============================================================
// Identity & Access (DATABASE.md, 3.1)
// ============================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum AuthProvider {
  EMAIL_PASSWORD
  TELEGRAM
  MAX
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
  MESSENGER_LINK
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
  COMPETITION
}

enum GrantMode {
  DIRECT
  POLICY
  INHERITED
  LIMITED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

model User {
  id                     String     @id @default(uuid(7)) @db.Uuid
  email                  String?    @unique @db.Citext
  emailVerifiedAt        DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  displayName            String     @map("display_name")
  status                 UserStatus @default(PENDING_VERIFICATION)
  locale                 String     @default("ru")
  timezone               String?
  personId               String?    @unique @map("person_id") @db.Uuid
  totpSecretEnc          Bytes?     @map("totp_secret_enc")
  totpEnabledAt          DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  totpRecoveryCodeHashes String[]   @default([]) @map("totp_recovery_code_hashes")
  permissionsVersion     Int        @default(1) @map("permissions_version")
  lastLoginAt            DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?  @map("deleted_at") @db.Timestamptz(3)

  person                    Person?                  @relation("UserPerson", fields: [personId], references: [id], onDelete: Restrict)
  identities                AuthIdentity[]
  refreshTokens             RefreshToken[]
  verificationTokens        VerificationToken[]
  platformRoles             PlatformRoleAssignment[] @relation("PlatformRoleUser")
  grantedPlatformRoles      PlatformRoleAssignment[] @relation("PlatformRoleGrantor")
  organizationMemberships   OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships        OrganizationMembership[] @relation("MembershipInviter")
  competitionMemberships    CompetitionMembership[]  @relation("CompetitionMembershipUser")
  invitedCompetitionStaff   CompetitionMembership[]  @relation("CompetitionMembershipInviter")
  createdOrganizations      Organization[]           @relation("OrganizationCreator")
  createdPersons            Person[]                 @relation("PersonCreator")
  uploadedFiles             StoredFile[]
  auditEntries              AuditLog[]
  dataAccessEntries         DataAccessLog[]
  updatedSettings           SystemSetting[]
  createdAthletes           AthleteProfile[]         @relation("AthleteCreator")
  createdCoaches            CoachProfile[]           @relation("CoachCreator")
  createdCoachMemberships   CoachMembership[]        @relation("CoachMembershipCreator")
  createdReferees           RefereeProfile[]         @relation("RefereeCreator")
  createdAthleteMemberships AthleteMembership[]      @relation("AthleteMembershipCreator")
  createdAthleteCoaches     AthleteCoach[]           @relation("AthleteCoachCreator")
  createdRanks              AthleteRankRecord[]      @relation("RankCreator")
  revokedRanks              AthleteRankRecord[]      @relation("RankRevoker")
  createdGuardians          Guardian[]               @relation("GuardianCreator")
  verifiedGuardians         Guardian[]               @relation("GuardianVerifier")
  endedGuardians            Guardian[]               @relation("GuardianEnder")
  createdConsentTemplates   ConsentTemplate[]        @relation("ConsentTemplateCreator")
  recordedConsents          Consent[]                @relation("ConsentRecorder")
  revokedConsents           Consent[]                @relation("ConsentRevoker")
  createdRuleSets           RuleSet[]                @relation("RuleSetCreator")
  createdRuleSetVersions    RuleSetVersion[]         @relation("RuleSetVersionCreator")
  publishedRuleSetVersions  RuleSetVersion[]         @relation("RuleSetPublisher")
  createdAgeGroups          AgeGroup[]               @relation("AgeGroupCreator")
  createdCategoryTemplates  CategoryTemplate[]       @relation("CategoryTemplateCreator")
  uploadedDocuments         Document[]               @relation("DocumentUploader")
  reviewedDocuments         Document[]               @relation("DocumentReviewer")
  importJobs                ImportJob[]              @relation("ImportCreator")
  createdVenues             Venue[]                  @relation("VenueCreator")
  createdCompetitions       Competition[]            @relation("CompetitionCreator")
  updatedCompetitions       Competition[]            @relation("CompetitionUpdater")
  createdApplications       Application[]            @relation("ApplicationCreator")
  submittedApplications     Application[]            @relation("ApplicationSubmitter")
  reviewedApplications      Application[]            @relation("ApplicationReviewer")
  createdEntries            Entry[]                  @relation("EntryCreator")
  decidedEntries            Entry[]                  @relation("EntryDecider")
  withdrawnEntries          Entry[]                  @relation("EntryWithdrawer")
  acquiredLeases            CompetitionWriteLease[]  @relation("LeaseAcquirer")
  waivedAdmissionChecks     AdmissionCheck[]         @relation("AdmissionCheckUpdater")
  checkInOperations         CheckIn[]                @relation("CheckInOperator")
  weighInAttempts           WeighInAttempt[]         @relation("WeighInOperator")
  recordedClearances        MedicalClearance[]       @relation("ClearanceRecorder")
  revokedClearances         MedicalClearance[]       @relation("ClearanceRevoker")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  createdDraws              Draw[]                   @relation("DrawCreator")
  publishedDraws            Draw[]                   @relation("DrawPublisher")
  supersededDraws           Draw[]                   @relation("DrawSuperseder")
  publishedSchedules        Schedule[]               @relation("SchedulePublisher")
  matAssignments            MatAssignment[]
  recordedMatchEvents       MatchEvent[]             @relation("MatchEventRecorder")
  publishedCategoryResults  CategoryResult[]         @relation("CategoryResultPublisher")
  matchResultRevisions      MatchResultRevision[]    @relation("MatchResultReviser")
  medicalIncidents          MedicalIncident[]        @relation("MedicalIncidentRecorder")
  proposedMatchResults      MatchResult[]            @relation("MatchResultProposer")
  confirmedMatchResults     MatchResult[]            @relation("MatchResultConfirmer")

  @@index([status, createdAt])
  @@map("user")
}

model AuthIdentity {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  secretHash      String?      @map("secret_hash")
  metadata        Json?
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identity")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  ip           String?   @db.Inet
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("RefreshRotation")

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_token")
}

model VerificationToken {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  Bytes        @unique @map("token_hash")
  payload    Json?
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([userId, purpose])
  @@map("verification_token")
}

model Role {
  id       String    @id @default(uuid(7)) @db.Uuid
  code     String    @unique
  scope    RoleScope
  isSystem Boolean   @default(true) @map("is_system")
  nameKey  String    @map("name_key")

  permissions             RolePermission[]
  platformAssignments     PlatformRoleAssignment[]
  organizationMemberships OrganizationMembership[]
  competitionMemberships  CompetitionMembership[]

  @@map("role")
}

model Permission {
  code        String      @id
  module      String
  description String
  scopes      RoleScope[]

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId         String    @map("role_id") @db.Uuid
  permissionCode String    @map("permission_code")
  mode           GrantMode @default(DIRECT)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model PlatformRoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  user      User  @relation("PlatformRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("PlatformRoleGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("platform_role_assignment")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  invitedEmail   String?          @map("invited_email") @db.Citext
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  validFrom      DateTime?        @map("valid_from") @db.Date
  validTo        DateTime?        @map("valid_to") @db.Date
  invitedById    String?          @map("invited_by_id") @db.Uuid
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_membership")
}

/// Персонал турнира. Как и в организации, приглашение по email ждёт принятия: до него `userId` пуст,
/// а `invitedEmail` хранит адрес (Phase 4).
model CompetitionMembership {
  id            String           @id @default(uuid(7)) @db.Uuid
  competitionId String           @map("competition_id") @db.Uuid
  userId        String?          @map("user_id") @db.Uuid
  invitedEmail  String?          @map("invited_email") @db.Citext
  roleId        String           @map("role_id") @db.Uuid
  status        MembershipStatus @default(INVITED)
  invitedById   String?          @map("invited_by_id") @db.Uuid
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  user        User?       @relation("CompetitionMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User?       @relation("CompetitionMembershipInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([competitionId, roleId])
  @@map("competition_membership")
}

// ============================================================
// People — минимальный Person (Phase 2); профили — Phase 3 (DATABASE.md, 3.3)
// ============================================================

enum Gender {
  MALE
  FEMALE
}

model Person {
  id            String               @id @default(uuid(7)) @db.Uuid
  lastName      String               @map("last_name")
  firstName     String               @map("first_name")
  middleName    String?              @map("middle_name")
  birthDate     DateTime             @map("birth_date") @db.Date
  gender        Gender
  countryCode   String?              @map("country_code") @db.Char(2)
  regionId      String?              @map("region_id") @db.Uuid
  city          String?
  photoFileId   String?              @map("photo_file_id") @db.Uuid
  lastNameNorm  Unsupported("text")? @map("last_name_norm")
  firstNameNorm Unsupported("text")? @map("first_name_norm")
  mergedIntoId  String?              @map("merged_into_id") @db.Uuid
  createdById   String?              @map("created_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(3)

  user       User?       @relation("UserPerson")
  country    Country?    @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  region     Region?     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  photo      StoredFile? @relation("PersonPhoto", fields: [photoFileId], references: [id], onDelete: Restrict)
  mergedInto Person?     @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom Person[]    @relation("PersonMerge")
  createdBy  User?       @relation("PersonCreator", fields: [createdById], references: [id], onDelete: Restrict)

  athleteProfile    AthleteProfile?
  coachProfile      CoachProfile?
  refereeProfile    RefereeProfile?
  guardianOf        Guardian[]      @relation("GuardianPerson")
  consentsAsSubject Consent[]       @relation("ConsentSubject")
  consentsGiven     Consent[]       @relation("ConsentGiver")

  @@map("person")
}

// ============================================================
// Organizations (DATABASE.md, 3.2)
// ============================================================

enum OrganizationType {
  NATIONAL_FEDERATION
  REGIONAL_FEDERATION
  CLUB
  SPORTS_SCHOOL
  ORGANIZER
  OTHER
}

enum OrganizationStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Country {
  code   String @id @db.Char(2)
  nameRu String @map("name_ru")
  nameEn String @map("name_en")

  regions       Region[]
  organizations Organization[]
  persons       Person[]

  @@map("country")
}

model Region {
  id          String @id @default(uuid(7)) @db.Uuid
  countryCode String @map("country_code") @db.Char(2)
  code        String
  nameRu      String @map("name_ru")
  nameEn      String @map("name_en")

  country            Country        @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  organizations      Organization[]
  persons            Person[]
  venues             Venue[]
  representedApps    Application[]  @relation("ApplicationRegion")
  entrySnapRegions   Entry[]        @relation("EntrySnapRegion")
  representedEntries Entry[]        @relation("EntryRepresentationRegion")

  @@unique([countryCode, code])
  @@unique([code])
  @@map("region")
}

model Organization {
  id           String               @id @default(uuid(7)) @db.Uuid
  type         OrganizationType
  parentId     String?              @map("parent_id") @db.Uuid
  name         String
  shortName    String               @map("short_name")
  slug         String               @unique
  logoFileId   String?              @map("logo_file_id") @db.Uuid
  countryCode  String               @map("country_code") @db.Char(2)
  regionId     String?              @map("region_id") @db.Uuid
  city         String?
  address      String?
  contactEmail String?              @map("contact_email") @db.Citext
  contactPhone String?              @map("contact_phone")
  website      String?
  status       OrganizationStatus   @default(PENDING_REVIEW)
  nameNorm     Unsupported("text")? @map("name_norm")
  version      Int                  @default(1)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(3)

  parent       Organization?             @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Organization[]            @relation("OrganizationHierarchy")
  logo         StoredFile?               @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: Restrict)
  country      Country                   @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  region       Region?                   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdBy    User?                     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  legalDetails OrganizationLegalDetails?
  ancestors    OrganizationClosure[]     @relation("ClosureDescendant")
  descendants  OrganizationClosure[]     @relation("ClosureAncestor")
  memberships  OrganizationMembership[]

  athleteMemberships AthleteMembership[]
  coachMemberships   CoachMembership[]
  ruleSets           RuleSet[]           @relation("RuleSetOwner")
  ageGroups          AgeGroup[]          @relation("AgeGroupOwner")
  categoryTemplates  CategoryTemplate[]  @relation("CategoryTemplateOwner")
  documents          Document[]          @relation("OrganizationDocument")
  importJobs         ImportJob[]         @relation("ImportOrganization")
  venues             Venue[]             @relation("VenueOwner")
  competitions       Competition[]       @relation("CompetitionOrganizer")
  applications       Application[]       @relation("ApplicationOrganization")
  representedApps    Application[]       @relation("ApplicationRepresentation")
  entrySnapClubs     Entry[]             @relation("EntrySnapClub")
  representedEntries Entry[]             @relation("EntryRepresentation")

  @@index([parentId])
  @@index([regionId, type, status])
  @@map("organization")
}

model OrganizationLegalDetails {
  organizationId String   @id @map("organization_id") @db.Uuid
  legalName      String   @map("legal_name")
  inn            String
  kpp            String?
  ogrn           String?
  legalAddress   String   @map("legal_address")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_legal_details")
}

model OrganizationClosure {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   Organization @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Restrict)
  descendant Organization @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Restrict)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("organization_closure")
}

// ============================================================
// Справочники Phase 2 (API.md, 3.7; DATABASE.md, 3.3–3.5)
// ============================================================

enum Sensitivity {
  HEALTH
  IDENTITY
  GENERAL
}

model SportRank {
  code      String @id
  nameRu    String @map("name_ru")
  nameEn    String @map("name_en")
  rankOrder Int    @unique @map("rank_order")

  rankRecords AthleteRankRecord[]

  @@map("sport_rank")
}

model RefereeCategory {
  code      String @id
  nameRu    String @map("name_ru")
  nameEn    String @map("name_en")
  rankOrder Int    @unique @map("rank_order")

  referees RefereeProfile[]

  @@map("referee_category")
}

model Discipline {
  code   String @id
  nameRu String @map("name_ru")
  nameEn String @map("name_en")

  ruleSets          RuleSet[]
  ageGroups         AgeGroup[]
  categoryTemplates CategoryTemplate[]
  competitions      Competition[]

  @@map("discipline")
}

model DocumentType {
  code          String      @id
  nameRu        String      @map("name_ru")
  nameEn        String      @map("name_en")
  sensitivity   Sensitivity
  allowedMime   String      @map("allowed_mime")
  maxSizeBytes  Int         @map("max_size_bytes")
  retentionDays Int         @map("retention_days")

  documents    Document[]
  requirements CompetitionRequirement[]

  @@map("document_type")
}

// ============================================================
// Platform (DATABASE.md, 3.9)
// ============================================================

enum FileBucket {
  PUBLIC_MEDIA
  PRIVATE_DOCUMENTS
  GENERATED
}

enum FileStatus {
  PENDING_UPLOAD
  AVAILABLE
  REJECTED
  DELETED
}

enum ActorType {
  USER
  SYSTEM
  NODE
}

enum AccessAction {
  VIEW
  DOWNLOAD
  DENIED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model StoredFile {
  id           String     @id @default(uuid(7)) @db.Uuid
  bucket       FileBucket
  purpose      String
  storageKey   String     @unique @map("storage_key")
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  sha256       String
  status       FileStatus @default(PENDING_UPLOAD)
  uploadedById String?    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  uploadedBy        User?          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  organizationLogos Organization[] @relation("OrganizationLogo")
  personPhotos      Person[]       @relation("PersonPhoto")
  document          Document?      @relation("DocumentFile")
  importJobs        ImportJob[]    @relation("ImportFile")
  competitionLogos  Competition[]  @relation("CompetitionLogo")
  regulations       Competition[]  @relation("CompetitionRegulation")

  @@index([status, createdAt])
  @@map("stored_file")
}

/// Партиционирована по месяцам (occurred_at). У роли приложения нет UPDATE/DELETE.
model AuditLog {
  id                   String    @default(uuid(7)) @db.Uuid
  occurredAt           DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType            ActorType @map("actor_type")
  actorUserId          String?   @map("actor_user_id") @db.Uuid
  nodeId               String?   @map("node_id") @db.Uuid
  action               String
  entityType           String    @map("entity_type")
  entityId             String?   @map("entity_id") @db.Uuid
  competitionId        String?   @map("competition_id") @db.Uuid
  organizationId       String?   @map("organization_id") @db.Uuid
  before               Json?
  after                Json?
  reason               String?
  platformIntervention Boolean   @default(false) @map("platform_intervention")
  ip                   String?   @db.Inet
  userAgent            String?   @map("user_agent")
  traceId              String?   @map("trace_id")

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([competitionId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
}

/// Партиционирована по месяцам (occurred_at). Append-only.
model DataAccessLog {
  id            String       @default(uuid(7)) @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userId        String?      @map("user_id") @db.Uuid
  action        AccessAction
  resourceType  String       @map("resource_type")
  resourceId    String       @map("resource_id") @db.Uuid
  competitionId String?      @map("competition_id") @db.Uuid
  ip            String?      @db.Inet
  userAgent     String?      @map("user_agent")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([id, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([userId, occurredAt])
  @@map("data_access_log")
}

model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  type          String
  schemaVersion Int          @default(1) @map("schema_version")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  competitionId String?      @map("competition_id") @db.Uuid
  traceId       String?      @map("trace_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(3)

  @@map("outbox_event")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_event")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_setting")
}

// ============================================================
// People — профили, членства, представители, согласия (DATABASE.md, 3.3; Phase 3)
// Производные значения (текущий клуб, тренер, разряд, возраст) не хранятся.
// ============================================================

enum ProfileStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GuardianRelation {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  OTHER
}

enum GuardianVerificationBasis {
  DOCUMENT_SHOWN
  PAPER_APPLICATION
}

enum ConsentKind {
  PD_PROCESSING
  PD_DISTRIBUTION
  HEALTH_DATA
}

enum ConsentMethod {
  ELECTRONIC
  PAPER_SCAN
}

model AthleteProfile {
  id          String        @id @default(uuid(7)) @db.Uuid
  personId    String        @unique @map("person_id") @db.Uuid
  publicId    String        @unique @map("public_id")
  status      ProfileStatus @default(ACTIVE)
  version     Int           @default(1)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  person      Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("AthleteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships AthleteMembership[]
  coaches     AthleteCoach[]
  ranks       AthleteRankRecord[]
  guardians   Guardian[]
  documents   Document[]
  entries     Entry[]
  results     AthleteResult[]
  checkIns    CheckIn[]
  clearances  MedicalClearance[]

  @@map("athlete_profile")
}

model CoachProfile {
  id          String        @id @default(uuid(7)) @db.Uuid
  personId    String        @unique @map("person_id") @db.Uuid
  status      ProfileStatus @default(ACTIVE)
  version     Int           @default(1)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  person       Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("CoachCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships  CoachMembership[]
  athletes     AthleteCoach[]
  applications Application[]

  @@map("coach_profile")
}

/// Тренер в организации (клубе, спортшколе) с периодом. Не зависит от аккаунта: тренер без входа в систему
/// тоже бывает. Права тренера-пользователя даёт OrganizationMembership с ролью COACH.
model CoachMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  coachId        String    @map("coach_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  coach        CoachProfile @relation(fields: [coachId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("CoachMembershipCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, validTo])
  @@index([coachId])
  @@map("coach_membership")
}

model RefereeProfile {
  id                  String        @id @default(uuid(7)) @db.Uuid
  personId            String        @unique @map("person_id") @db.Uuid
  refereeCategoryCode String        @map("referee_category_code")
  categoryAssignedAt  DateTime?     @map("category_assigned_at") @db.Date
  status              ProfileStatus @default(ACTIVE)
  version             Int           @default(1)
  createdById         String?       @map("created_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  person    Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  category  RefereeCategory @relation(fields: [refereeCategoryCode], references: [code], onDelete: Restrict)
  createdBy User?           @relation("RefereeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([refereeCategoryCode])
  @@map("referee_profile")
}

model AthleteMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  athleteId      String    @map("athlete_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  isPrimary      Boolean   @map("is_primary")
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("AthleteMembershipCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, validTo])
  @@index([athleteId])
  @@map("athlete_membership")
}

model AthleteCoach {
  id          String    @id @default(uuid(7)) @db.Uuid
  athleteId   String    @map("athlete_id") @db.Uuid
  coachId     String    @map("coach_id") @db.Uuid
  isPrimary   Boolean   @map("is_primary")
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  coach     CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("AthleteCoachCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([coachId, validTo])
  @@index([athleteId])
  @@map("athlete_coach")
}

model AthleteRankRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  athleteId     String    @map("athlete_id") @db.Uuid
  sportRankCode String    @map("sport_rank_code")
  assignedAt    DateTime  @map("assigned_at") @db.Date
  orderRef      String?   @map("order_ref")
  documentId    String?   @map("document_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokeReason  String?   @map("revoke_reason")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  sportRank SportRank      @relation(fields: [sportRankCode], references: [code], onDelete: Restrict)
  document  Document?      @relation("RankDocument", fields: [documentId], references: [id], onDelete: Restrict)
  revokedBy User?          @relation("RankRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  createdBy User?          @relation("RankCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("athlete_rank_record")
}

/// Законный представитель. Связь не удаляется: прекращается (`endedAt`) с причиной — история остаётся.
model Guardian {
  id                String                     @id @default(uuid(7)) @db.Uuid
  athleteId         String                     @map("athlete_id") @db.Uuid
  guardianPersonId  String                     @map("guardian_person_id") @db.Uuid
  relation          GuardianRelation
  verifiedAt        DateTime?                  @map("verified_at") @db.Timestamptz(3)
  verifiedById      String?                    @map("verified_by_id") @db.Uuid
  verificationBasis GuardianVerificationBasis? @map("verification_basis")
  endedAt           DateTime?                  @map("ended_at") @db.Timestamptz(3)
  endedById         String?                    @map("ended_by_id") @db.Uuid
  endReason         String?                    @map("end_reason")
  createdById       String?                    @map("created_by_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  athlete        AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  guardianPerson Person         @relation("GuardianPerson", fields: [guardianPersonId], references: [id], onDelete: Restrict)
  verifiedBy     User?          @relation("GuardianVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  endedBy        User?          @relation("GuardianEnder", fields: [endedById], references: [id], onDelete: Restrict)
  createdBy      User?          @relation("GuardianCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([guardianPersonId])
  @@index([athleteId])
  @@map("guardian")
}

/// Текст согласия. После публикации не меняется (триггер): доказуемо, на какой текст дано согласие.
model ConsentTemplate {
  id           String      @id @default(uuid(7)) @db.Uuid
  kind         ConsentKind
  version      Int
  locale       String
  operatorName String      @map("operator_name")
  bodyMarkdown String      @map("body_markdown")
  publishedAt  DateTime?   @map("published_at") @db.Timestamptz(3)
  retiredAt    DateTime?   @map("retired_at") @db.Timestamptz(3)
  createdById  String?     @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?     @relation("ConsentTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  consents  Consent[]

  @@unique([kind, version, locale])
  @@map("consent_template")
}

/// Согласие: на всё время (`competitionId` пуст) или на конкретный турнир.
model Consent {
  id              String        @id @default(uuid(7)) @db.Uuid
  subjectPersonId String        @map("subject_person_id") @db.Uuid
  givenByPersonId String        @map("given_by_person_id") @db.Uuid
  templateId      String        @map("template_id") @db.Uuid
  competitionId   String?       @map("competition_id") @db.Uuid
  method          ConsentMethod
  documentId      String?       @map("document_id") @db.Uuid
  givenAt         DateTime      @map("given_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedById     String?       @map("revoked_by_id") @db.Uuid
  revokeReason    String?       @map("revoke_reason")
  recordedById    String?       @map("recorded_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  subject     Person          @relation("ConsentSubject", fields: [subjectPersonId], references: [id], onDelete: Restrict)
  competition Competition?    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  givenBy     Person          @relation("ConsentGiver", fields: [givenByPersonId], references: [id], onDelete: Restrict)
  template    ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  document    Document?       @relation("ConsentDocument", fields: [documentId], references: [id], onDelete: Restrict)
  revokedBy   User?           @relation("ConsentRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  recordedBy  User?           @relation("ConsentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([givenByPersonId])
  @@map("consent")
}

// ============================================================
// Rules & Setup — правила, возрастные группы, весовые категории, шаблоны (DATABASE.md, 3.4; Phase 3)
// ============================================================

enum RuleSetVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AgeCalculationPolicy {
  BY_BIRTH_YEAR
  EXACT_ON_DATE
  BIRTH_YEAR_RANGE
}

enum WeightLimitKind {
  UP_TO
  ABOVE
}

model RuleSet {
  id                  String        @id @default(uuid(7)) @db.Uuid
  code                String        @unique
  disciplineCode      String        @map("discipline_code")
  ownerOrganizationId String?       @map("owner_organization_id") @db.Uuid
  name                String
  status              ProfileStatus @default(ACTIVE)
  createdById         String?       @map("created_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  discipline        Discipline       @relation(fields: [disciplineCode], references: [code], onDelete: Restrict)
  ownerOrganization Organization?    @relation("RuleSetOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  createdBy         User?            @relation("RuleSetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions          RuleSetVersion[]

  @@index([ownerOrganizationId])
  @@map("rule_set")
}

/// Версия правил. После публикации неизменяема (триггер forbid_update_published): турнир закрепляет версию (ADR-09).
model RuleSetVersion {
  id            String               @id @default(uuid(7)) @db.Uuid
  ruleSetId     String               @map("rule_set_id") @db.Uuid
  version       Int
  schemaVersion Int                  @map("schema_version")
  parameters    Json
  checksum      String?
  status        RuleSetVersionStatus @default(DRAFT)
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(3)
  publishedById String?              @map("published_by_id") @db.Uuid
  createdById   String?              @map("created_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  ruleSet      RuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  publishedBy  User?         @relation("RuleSetPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("RuleSetVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  competitions Competition[]

  @@unique([ruleSetId, version])
  @@map("rule_set_version")
}

model AgeGroup {
  id                  String               @id @default(uuid(7)) @db.Uuid
  disciplineCode      String               @map("discipline_code")
  ownerOrganizationId String?              @map("owner_organization_id") @db.Uuid
  code                String
  nameRu              String               @map("name_ru")
  nameEn              String               @map("name_en")
  policy              AgeCalculationPolicy @default(BY_BIRTH_YEAR)
  ageFrom             Int                  @map("age_from")
  ageTo               Int                  @map("age_to")
  createdById         String?              @map("created_by_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)

  discipline            Discipline             @relation(fields: [disciplineCode], references: [code], onDelete: Restrict)
  ownerOrganization     Organization?          @relation("AgeGroupOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("AgeGroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  weightCategories      WeightCategory[]
  templateItems         CategoryTemplateItem[]
  competitionCategories CompetitionCategory[]

  @@index([disciplineCode])
  @@map("age_group")
}

model WeightCategory {
  id         String          @id @default(uuid(7)) @db.Uuid
  ageGroupId String          @map("age_group_id") @db.Uuid
  gender     Gender
  kind       WeightLimitKind
  limitGrams Int             @map("limit_grams")
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(3)

  ageGroup      AgeGroup               @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)
  templateItems CategoryTemplateItem[]

  @@index([ageGroupId])
  @@map("weight_category")
}

model CategoryTemplate {
  id                  String    @id @default(uuid(7)) @db.Uuid
  ownerOrganizationId String?   @map("owner_organization_id") @db.Uuid
  disciplineCode      String    @map("discipline_code")
  name                String
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  ownerOrganization Organization?          @relation("CategoryTemplateOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  discipline        Discipline             @relation(fields: [disciplineCode], references: [code], onDelete: Restrict)
  createdBy         User?                  @relation("CategoryTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items             CategoryTemplateItem[]

  @@map("category_template")
}

model CategoryTemplateItem {
  id               String @id @default(uuid(7)) @db.Uuid
  templateId       String @map("template_id") @db.Uuid
  ageGroupId       String @map("age_group_id") @db.Uuid
  gender           Gender
  weightCategoryId String @map("weight_category_id") @db.Uuid

  template       CategoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ageGroup       AgeGroup         @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)
  weightCategory WeightCategory   @relation(fields: [weightCategoryId], references: [id], onDelete: Restrict)

  @@unique([templateId, weightCategoryId])
  @@map("category_template_item")
}

// ============================================================
// Documents (DATABASE.md, 3.5; Phase 3). Владелец — спортсмен, заявка или организация; турнир — контекст проверки.
// ============================================================

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model Document {
  id             String         @id @default(uuid(7)) @db.Uuid
  typeCode       String         @map("type_code")
  athleteId      String?        @map("athlete_id") @db.Uuid
  applicationId  String?        @map("application_id") @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  competitionId  String?        @map("competition_id") @db.Uuid
  fileId         String         @unique @map("file_id") @db.Uuid
  status         DocumentStatus @default(UPLOADED)
  expirationDate DateTime?      @map("expiration_date") @db.Date
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  uploadedAt     DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  reviewedById   String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  rejectReason   String?        @map("reject_reason")
  version        Int            @default(1)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  type         DocumentType        @relation(fields: [typeCode], references: [code], onDelete: Restrict)
  athlete      AthleteProfile?     @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  application  Application?        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  organization Organization?       @relation("OrganizationDocument", fields: [organizationId], references: [id], onDelete: Restrict)
  competition  Competition?        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  file         StoredFile          @relation("DocumentFile", fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy   User?               @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy   User?               @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  rankRecords  AthleteRankRecord[] @relation("RankDocument")
  consents     Consent[]           @relation("ConsentDocument")
  clearances   MedicalClearance[]  @relation("ClearanceDocument")

  @@index([athleteId, typeCode, status])
  @@index([applicationId])
  @@index([organizationId])
  @@index([competitionId])
  @@index([status, uploadedAt])
  @@map("document")
}

// ============================================================
// Фоновый импорт (DATABASE.md, 3.9; Phase 3)
// ============================================================

enum ImportKind {
  ATHLETES
}

enum JobStatus {
  PENDING
  PARSED
  COMMITTED
  FAILED
}

model ImportJob {
  id             String     @id @default(uuid(7)) @db.Uuid
  kind           ImportKind @default(ATHLETES)
  organizationId String     @map("organization_id") @db.Uuid
  fileId         String     @map("file_id") @db.Uuid
  status         JobStatus  @default(PENDING)
  errorCode      String?    @map("error_code")
  report         Json?
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  parsedAt       DateTime?  @map("parsed_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation("ImportOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  file         StoredFile   @relation("ImportFile", fields: [fileId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ImportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@map("import_job")
}

// ============================================================
// Competitions — турнир, место, категории турнира, правила допуска, требования (DATABASE.md, 3.4; Phase 4a)
// ============================================================

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECK_IN
  DRAWING
  SCHEDULED
  IN_PROGRESS
  FINISHED
  ARCHIVED
  CANCELLED
}

enum CompetitionLevel {
  CLUB
  CITY
  REGIONAL
  INTERREGIONAL
  NATIONAL
  INTERNATIONAL
}

enum CategoryStatus {
  REGISTRATION
  CLOSED
  WEIGH_IN
  READY_FOR_DRAW
  DRAWN
  IN_PROGRESS
  COMPLETED
  RESULTS_PUBLISHED
  MERGED
  CANCELLED
}

enum CompetitionFormatCode {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  ELIMINATION_WITH_REPECHAGE
  DOUBLE_ELIMINATION
  PENALTY_POINTS_ELIMINATION
  GROUP_STAGE
  GROUP_PLUS_PLAYOFF
}

enum CategoryRuleKind {
  MIN_RANK
  MAX_RANK
  ALLOW_YOUNGER
  MAX_CATEGORIES_PER_ATHLETE
  REGION_ONLY
}

enum RequirementKind {
  DOCUMENT
  CONSENT
  MEDICAL_CLEARANCE
  INSURANCE
  WEIGH_IN
  CHECK_IN
}

model Venue {
  id                  String    @id @default(uuid(7)) @db.Uuid
  ownerOrganizationId String    @map("owner_organization_id") @db.Uuid
  name                String
  address             String?
  city                String?
  regionId            String?   @map("region_id") @db.Uuid
  timezone            String
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner        Organization  @relation("VenueOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  region       Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("VenueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  competitions Competition[]

  @@index([ownerOrganizationId])
  @@map("venue")
}

/// Турнир. Опубликованный турнир всегда с закреплённой версией правил (CHECK); после публикации
/// дисциплина и версия правил не меняются. Сроки турнира — календарные даты в его timezone.
model Competition {
  id                      String                @id @default(uuid(7)) @db.Uuid
  slug                    String                @unique
  name                    String
  shortName               String?               @map("short_name")
  descriptionMd           String?               @map("description_md")
  organizerOrganizationId String                @map("organizer_organization_id") @db.Uuid
  venueId                 String?               @map("venue_id") @db.Uuid
  timezone                String
  startDate               DateTime              @map("start_date") @db.Date
  endDate                 DateTime              @map("end_date") @db.Date
  registrationStartsAt    DateTime              @map("registration_starts_at") @db.Timestamptz(3)
  registrationEndsAt      DateTime              @map("registration_ends_at") @db.Timestamptz(3)
  status                  CompetitionStatus     @default(DRAFT)
  level                   CompetitionLevel
  disciplineCode          String                @map("discipline_code")
  ruleSetVersionId        String?               @map("rule_set_version_id") @db.Uuid
  logoFileId              String?               @map("logo_file_id") @db.Uuid
  regulationFileId        String?               @map("regulation_file_id") @db.Uuid
  requirementsMd          String?               @map("requirements_md")
  contactInfo             Json?                 @map("contact_info")
  nameNorm                Unsupported("text")?  @map("name_norm")
  version                 Int                   @default(1)
  createdById             String?               @map("created_by_id") @db.Uuid
  updatedById             String?               @map("updated_by_id") @db.Uuid
  publishedAt             DateTime?             @map("published_at") @db.Timestamptz(3)
  cancelledAt             DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelReason            String?               @map("cancel_reason")
  /// Исход неудачного официального взвешивания по положению (D-06).
  weighInFailureOutcome   WeighInFailureOutcome @default(RECHECK) @map("weigh_in_failure_outcome")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz(3)

  organizer         Organization             @relation("CompetitionOrganizer", fields: [organizerOrganizationId], references: [id], onDelete: Restrict)
  venue             Venue?                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  discipline        Discipline               @relation(fields: [disciplineCode], references: [code], onDelete: Restrict)
  ruleSetVersion    RuleSetVersion?          @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)
  logo              StoredFile?              @relation("CompetitionLogo", fields: [logoFileId], references: [id], onDelete: Restrict)
  regulation        StoredFile?              @relation("CompetitionRegulation", fields: [regulationFileId], references: [id], onDelete: Restrict)
  createdBy         User?                    @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?                    @relation("CompetitionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  staff             CompetitionMembership[]
  categories        CompetitionCategory[]
  categoryRules     CategoryRule[]
  requirements      CompetitionRequirement[]
  applications      Application[]
  entries           Entry[]
  writeLease        CompetitionWriteLease?
  documents         Document[]
  consents          Consent[]
  admissions        Admission[]
  checkIns          CheckIn[]
  scales            Scale[]
  weighInWindows    WeighInWindow[]
  weighInRecords    WeighInRecord[]
  clearances        MedicalClearance[]
  draws             Draw[]
  drawSlots         DrawSlot[]
  brackets          Bracket[]
  bracketNodes      BracketNode[]
  matches           Match[]
  matchParticipants MatchParticipant[]
  mats              Mat[]
  sessions          Session[]
  schedule          Schedule?
  matchSchedules    MatchSchedule[]
  matAssignments    MatAssignment[]
  matchEvents       MatchEvent[]
  matchResults      MatchResult[]
  matchRevisions    MatchResultRevision[]
  categoryResults   CategoryResult[]
  placements        Placement[]
  athleteResults    AthleteResult[]
  medicalIncidents  MedicalIncident[]

  @@index([status, startDate])
  @@index([organizerOrganizationId, startDate])
  @@map("competition")
}

/// Категория турнира со снимком границ возраста и веса: правка шаблона не меняет турнир.
/// Своя машина состояний (ARCHITECTURE.md, 16.2); объединённая категория указывает на целевую.
model CompetitionCategory {
  id               String                 @id @default(uuid(7)) @db.Uuid
  competitionId    String                 @map("competition_id") @db.Uuid
  code             String
  nameRu           String                 @map("name_ru")
  nameEn           String                 @map("name_en")
  gender           Gender
  ageGroupId       String?                @map("age_group_id") @db.Uuid
  agePolicy        AgeCalculationPolicy   @map("age_policy")
  ageFrom          Int?                   @map("age_from")
  ageTo            Int?                   @map("age_to")
  birthYearFrom    Int?                   @map("birth_year_from")
  birthYearTo      Int?                   @map("birth_year_to")
  ageReferenceDate DateTime?              @map("age_reference_date") @db.Date
  weightKind       WeightLimitKind        @map("weight_kind")
  weightLowerGrams Int?                   @map("weight_lower_grams")
  weightUpperGrams Int?                   @map("weight_upper_grams")
  formatOverride   CompetitionFormatCode? @map("format_override")
  status           CategoryStatus         @default(REGISTRATION)
  mergedIntoId     String?                @map("merged_into_id") @db.Uuid
  sortOrder        Int                    @default(0) @map("sort_order")
  version          Int                    @default(1)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition     Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  ageGroup        AgeGroup?                @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)
  mergedInto      CompetitionCategory?     @relation("CategoryMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom      CompetitionCategory[]    @relation("CategoryMerge")
  rules           CategoryRule[]
  requirements    CompetitionRequirement[]
  entries         Entry[]                  @relation("EntryCategory")
  declaredEntries Entry[]                  @relation("EntryDeclaredCategory")
  weighInWindows  WeighInWindowCategory[]
  weighInAttempts WeighInAttempt[]
  draws           Draw[]
  brackets        Bracket[]
  matches         Match[]
  result          CategoryResult?
  athleteResults  AthleteResult[]

  @@unique([competitionId, code])
  @@index([competitionId, status])
  @@index([competitionId, gender, ageFrom])
  @@map("competition_category")
}

/// Правило допуска: на весь турнир (`categoryId` пуст) или на категорию. `params` — схема по `kind`.
model CategoryRule {
  id            String           @id @default(uuid(7)) @db.Uuid
  competitionId String           @map("competition_id") @db.Uuid
  categoryId    String?          @map("category_id") @db.Uuid
  kind          CategoryRuleKind
  params        Json
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  competition Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category    CompetitionCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([competitionId, categoryId])
  @@map("category_rule")
}

/// Требование положения для допуска (документ, согласие, медицинский допуск, страховка, взвешивание, прибытие).
model CompetitionRequirement {
  id               String          @id @default(uuid(7)) @db.Uuid
  competitionId    String          @map("competition_id") @db.Uuid
  categoryId       String?         @map("category_id") @db.Uuid
  kind             RequirementKind
  documentTypeCode String?         @map("document_type_code")
  consentKind      ConsentKind?    @map("consent_kind")
  mandatory        Boolean         @default(true)
  noteMd           String?         @map("note_md")

  competition  Competition          @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category     CompetitionCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documentType DocumentType?        @relation(fields: [documentTypeCode], references: [code], onDelete: Restrict)

  @@index([competitionId])
  @@map("competition_requirement")
}

// ============================================================
// Registrations — заявки и участия (DATABASE.md, 3.5; C-02; Phase 4a)
// ============================================================

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITING_DOCUMENTS
  CANCELLED
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Заявка клуба или спортшколы на турнир. Остаётся в облаке (DATABASE.md, 7).
model Application {
  id                           String            @id @default(uuid(7)) @db.Uuid
  competitionId                String            @map("competition_id") @db.Uuid
  organizationId               String            @map("organization_id") @db.Uuid
  coachId                      String?           @map("coach_id") @db.Uuid
  status                       ApplicationStatus @default(DRAFT)
  representationOrganizationId String?           @map("representation_organization_id") @db.Uuid
  representationRegionId       String?           @map("representation_region_id") @db.Uuid
  submittedAt                  DateTime?         @map("submitted_at") @db.Timestamptz(3)
  submittedByUserId            String?           @map("submitted_by_user_id") @db.Uuid
  reviewedAt                   DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedById                 String?           @map("reviewed_by_id") @db.Uuid
  reviewComment                String?           @map("review_comment")
  version                      Int               @default(1)
  createdById                  String?           @map("created_by_id") @db.Uuid
  createdAt                    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition          Competition   @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  organization         Organization  @relation("ApplicationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  coach                CoachProfile? @relation(fields: [coachId], references: [id], onDelete: Restrict)
  representationOrg    Organization? @relation("ApplicationRepresentation", fields: [representationOrganizationId], references: [id], onDelete: Restrict)
  representationRegion Region?       @relation("ApplicationRegion", fields: [representationRegionId], references: [id], onDelete: Restrict)
  submittedBy          User?         @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy           User?         @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdBy            User?         @relation("ApplicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries              Entry[]
  documents            Document[]

  @@index([competitionId, status])
  @@index([organizationId, competitionId])
  @@map("application")
}

/// Участие спортсмена в категории со снимком данных на момент заявки (ADR-10). Результаты ссылаются на Entry.
model Entry {
  id                           String      @id @default(uuid(7)) @db.Uuid
  competitionId                String      @map("competition_id") @db.Uuid
  applicationId                String      @map("application_id") @db.Uuid
  athleteId                    String      @map("athlete_id") @db.Uuid
  categoryId                   String      @map("category_id") @db.Uuid
  declaredCategoryId           String      @map("declared_category_id") @db.Uuid
  status                       EntryStatus @default(PENDING)
  snapLastName                 String      @map("snap_last_name")
  snapFirstName                String      @map("snap_first_name")
  snapMiddleName               String?     @map("snap_middle_name")
  snapBirthDate                DateTime    @map("snap_birth_date") @db.Date
  snapGender                   Gender      @map("snap_gender")
  snapClubId                   String?     @map("snap_club_id") @db.Uuid
  snapClubName                 String?     @map("snap_club_name")
  snapCoachName                String?     @map("snap_coach_name")
  snapRegionId                 String?     @map("snap_region_id") @db.Uuid
  snapRegionName               String?     @map("snap_region_name")
  snapRankCode                 String?     @map("snap_rank_code")
  representationOrganizationId String?     @map("representation_organization_id") @db.Uuid
  representationRegionId       String?     @map("representation_region_id") @db.Uuid
  publicName                   String      @map("public_name")
  declaredWeightGrams          Int?        @map("declared_weight_grams")
  /// Спортсмен на ковре (Phase 7a): идущая схватка. Ставится условным обновлением при старте (ATHLETE_IN_ACTIVE_MATCH),
  /// снимается при предварительном результате — второй ковёр не стартует схватку с тем же спортсменом.
  activeMatchId                String?     @map("active_match_id") @db.Uuid
  decidedAt                    DateTime?   @map("decided_at") @db.Timestamptz(3)
  decidedById                  String?     @map("decided_by_id") @db.Uuid
  decisionReason               String?     @map("decision_reason")
  withdrawnAt                  DateTime?   @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnById                String?     @map("withdrawn_by_id") @db.Uuid
  withdrawReason               String?     @map("withdraw_reason")
  version                      Int         @default(1)
  createdById                  String?     @map("created_by_id") @db.Uuid
  createdAt                    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition          Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  application          Application         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  athlete              AthleteProfile      @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  category             CompetitionCategory @relation("EntryCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  declaredCategory     CompetitionCategory @relation("EntryDeclaredCategory", fields: [declaredCategoryId], references: [id], onDelete: Restrict)
  snapClub             Organization?       @relation("EntrySnapClub", fields: [snapClubId], references: [id], onDelete: Restrict)
  snapRegion           Region?             @relation("EntrySnapRegion", fields: [snapRegionId], references: [id], onDelete: Restrict)
  representationOrg    Organization?       @relation("EntryRepresentation", fields: [representationOrganizationId], references: [id], onDelete: Restrict)
  representationRegion Region?             @relation("EntryRepresentationRegion", fields: [representationRegionId], references: [id], onDelete: Restrict)
  decidedBy            User?               @relation("EntryDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  withdrawnBy          User?               @relation("EntryWithdrawer", fields: [withdrawnById], references: [id], onDelete: Restrict)
  createdBy            User?               @relation("EntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  admission            Admission?
  weighInAttempts      WeighInAttempt[]
  weighInRecord        WeighInRecord?
  drawSlots            DrawSlot[]
  matchParticipations  MatchParticipant[]
  activeMatch          Match?              @relation("EntryActiveMatch", fields: [activeMatchId], references: [id], onDelete: Restrict)
  placements           Placement[]
  athleteResult        AthleteResult?
  medicalIncidents     MedicalIncident[]

  @@index([competitionId, status])
  @@index([applicationId])
  @@index([activeMatchId])
  @@index([athleteId])
  @@index([categoryId, status])
  @@map("entry")
}

// ============================================================
// Venue sync — право записи турнира и журнал синхронизации (DATABASE.md, 3.9, 7; ADR-21; Phase 4a)
// Узел (VenueNode, NodeAccessCode) — Phase 9.5; до неё держатель права — всегда облако.
// ============================================================

enum LeaseHolder {
  CLOUD
  NODE
}

enum LeaseStatus {
  ACTIVE
  CHECKING_OUT
  RETURNING
  RECOVERED
}

enum SyncOp {
  INSERT
  UPDATE
  DELETE
}

model CompetitionWriteLease {
  competitionId      String      @id @map("competition_id") @db.Uuid
  holderType         LeaseHolder @default(CLOUD) @map("holder_type")
  holderNodeId       String?     @map("holder_node_id") @db.Uuid
  epoch              Int         @default(1)
  status             LeaseStatus @default(ACTIVE)
  lastAppliedSyncSeq BigInt?     @map("last_applied_sync_seq")
  acquiredAt         DateTime    @default(now()) @map("acquired_at") @db.Timestamptz(3)
  acquiredById       String?     @map("acquired_by_id") @db.Uuid
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  acquiredBy  User?       @relation("LeaseAcquirer", fields: [acquiredById], references: [id], onDelete: Restrict)

  @@map("competition_write_lease")
}

/// Поток изменений операционных таблиц турнира. Пишут только триггеры (DATABASE.md, 7): код приложения
/// ничего для этого не делает, поэтому пропустить изменение нельзя.
model SyncLog {
  syncSeq       BigInt   @id @default(autoincrement()) @map("sync_seq")
  competitionId String   @map("competition_id") @db.Uuid
  epoch         Int
  tableName     String   @map("table_name")
  rowId         String   @map("row_id") @db.Uuid
  op            SyncOp
  rowImage      Json?    @map("row_image")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([competitionId, syncSeq])
  @@index([createdAt])
  @@map("sync_log")
}

// ============================================================
// Допуск, прибытие, взвешивание, медицинский допуск (DATABASE.md, 3.5; G-05, G-06, D-06; Phase 4b)
// Операционные таблицы турнира (кроме медицинского допуска) пишутся в журнал синхронизации триггерами
// и несут competition_id: триггер берёт из строки идентификатор турнира (DATABASE.md, 7).
// ============================================================

enum WeighInFailureOutcome {
  WITHDRAW
  RECHECK
  TRANSFER
}

enum AdmissionStatus {
  PENDING
  ADMITTED
  NOT_ADMITTED
}

enum AdmissionCheckKind {
  DOCUMENTS
  CONSENTS
  MEDICAL
  INSURANCE
  AGE
  QUALIFICATION
  WEIGHT
  CHECK_IN
}

enum AdmissionCheckStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum CheckInStatus {
  EXPECTED
  ARRIVED
  NOT_ARRIVED
  WITHDRAWN
}

enum CheckInMethod {
  QR
  SEARCH
  MANUAL
}

enum WeighInWindowKind {
  OFFICIAL
  CONTROL
}

enum WeighInAttemptKind {
  OFFICIAL
  CONTROL
  RECHECK
}

enum WeighInResult {
  PASSED
  FAILED
}

enum WeighInStatus {
  EXPECTED
  PASSED
  FAILED
  RECHECK_REQUIRED
}

enum MedicalClearanceStatus {
  VALID
  REVOKED
}

/// Допуск участия (G-06): проекция проверок, требуемых положением для категории участия. Статус вычисляется:
/// любая проверка FAILED — NOT_ADMITTED, иначе любая PENDING — PENDING, иначе ADMITTED.
model Admission {
  id            String          @id @default(uuid(7)) @db.Uuid
  competitionId String          @map("competition_id") @db.Uuid
  entryId       String          @unique @map("entry_id") @db.Uuid
  status        AdmissionStatus @default(PENDING)
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entry       Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  checks      AdmissionCheck[]

  @@index([competitionId, status])
  @@map("admission")
}

/// Проверка допуска с кодом причины. Исключение (WAIVED) — только с причиной (CHECK).
model AdmissionCheck {
  id            String               @id @default(uuid(7)) @db.Uuid
  competitionId String               @map("competition_id") @db.Uuid
  admissionId   String               @map("admission_id") @db.Uuid
  kind          AdmissionCheckKind
  status        AdmissionCheckStatus
  reasonCode    String?              @map("reason_code")
  reasonParams  Json?                @map("reason_params")
  waiverReason  String?              @map("waiver_reason")
  updatedById   String?              @map("updated_by_id") @db.Uuid
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation("AdmissionCheckUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([admissionId, kind])
  @@index([competitionId, kind, status])
  @@map("admission_check")
}

/// Прибытие спортсмена на турнир (раздел 15 ТЗ): одна строка на спортсмена, а не на участие.
model CheckIn {
  id            String         @id @default(uuid(7)) @db.Uuid
  competitionId String         @map("competition_id") @db.Uuid
  athleteId     String         @map("athlete_id") @db.Uuid
  status        CheckInStatus  @default(EXPECTED)
  method        CheckInMethod?
  arrivedAt     DateTime?      @map("arrived_at") @db.Timestamptz(3)
  operatorId    String?        @map("operator_id") @db.Uuid
  note          String?
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  operator    User?          @relation("CheckInOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([competitionId, athleteId])
  @@index([competitionId, status])
  @@map("check_in")
}

/// Весы турнира со сроком поверки: взвешивание на весах с истёкшей поверкой запрещено.
model Scale {
  id            String   @id @default(uuid(7)) @db.Uuid
  competitionId String   @map("competition_id") @db.Uuid
  name          String
  serialNumber  String?  @map("serial_number")
  verifiedUntil DateTime @map("verified_until") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  attempts    WeighInAttempt[]

  @@index([competitionId])
  @@map("scale")
}

/// Окно взвешивания (D-06): время и категории. Официальные окна одной категории не пересекаются.
model WeighInWindow {
  id            String            @id @default(uuid(7)) @db.Uuid
  competitionId String            @map("competition_id") @db.Uuid
  name          String
  startsAt      DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime          @map("ends_at") @db.Timestamptz(3)
  kind          WeighInWindowKind @default(OFFICIAL)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition             @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  categories  WeighInWindowCategory[]
  attempts    WeighInAttempt[]

  @@index([competitionId, startsAt])
  @@map("weigh_in_window")
}

/// Категории окна. Суррогатный `id` — идентификатор строки для журнала синхронизации.
model WeighInWindowCategory {
  id            String @id @default(uuid(7)) @db.Uuid
  competitionId String @map("competition_id") @db.Uuid
  windowId      String @map("window_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid

  window   WeighInWindow       @relation(fields: [windowId], references: [id], onDelete: Cascade)
  category CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([windowId, categoryId])
  @@index([categoryId])
  @@map("weigh_in_window_category")
}

/// Попытка взвешивания. Append-only (раздел 16 ТЗ): у роли приложения нет UPDATE и DELETE. Границы категории
/// и допуск — снимок на момент взвешивания.
model WeighInAttempt {
  id              String             @id @default(uuid(7)) @db.Uuid
  competitionId   String             @map("competition_id") @db.Uuid
  entryId         String             @map("entry_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  windowId        String             @map("window_id") @db.Uuid
  scaleId         String             @map("scale_id") @db.Uuid
  weightGrams     Int                @map("weight_grams")
  measuredAt      DateTime           @map("measured_at") @db.Timestamptz(3)
  kind            WeighInAttemptKind
  result          WeighInResult
  limitLowerGrams Int?               @map("limit_lower_grams")
  limitUpperGrams Int?               @map("limit_upper_grams")
  toleranceGrams  Int                @map("tolerance_grams")
  operatorId      String?            @map("operator_id") @db.Uuid
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  entry    Entry               @relation(fields: [entryId], references: [id], onDelete: Restrict)
  category CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  window   WeighInWindow       @relation(fields: [windowId], references: [id], onDelete: Restrict)
  scale    Scale               @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  operator User?               @relation("WeighInOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  records  WeighInRecord[]

  @@index([entryId, measuredAt])
  @@index([competitionId, measuredAt])
  @@map("weigh_in_attempt")
}

/// Итог взвешивания участия — проекция попыток, обновляется в той же транзакции, что и попытка.
model WeighInRecord {
  entryId       String        @id @map("entry_id") @db.Uuid
  competitionId String        @map("competition_id") @db.Uuid
  status        WeighInStatus @default(EXPECTED)
  lastAttemptId String?       @map("last_attempt_id") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  entry       Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  lastAttempt WeighInAttempt? @relation(fields: [lastAttemptId], references: [id], onDelete: Restrict)

  @@index([competitionId, status])
  @@map("weigh_in_record")
}

/// Медицинский допуск (G-05): факт, срок и кто выдал — без диагнозов. Только облако (DATABASE.md, 7).
/// `competitionId` пуст — допуск на период, иначе — на конкретный турнир.
model MedicalClearance {
  id            String                 @id @default(uuid(7)) @db.Uuid
  athleteId     String                 @map("athlete_id") @db.Uuid
  competitionId String?                @map("competition_id") @db.Uuid
  validUntil    DateTime               @map("valid_until") @db.Date
  issuedBy      String                 @map("issued_by")
  documentId    String?                @map("document_id") @db.Uuid
  status        MedicalClearanceStatus @default(VALID)
  recordedById  String?                @map("recorded_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?                @map("revoked_by_id") @db.Uuid
  revokeReason  String?                @map("revoke_reason")

  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  competition Competition?   @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  document    Document?      @relation("ClearanceDocument", fields: [documentId], references: [id], onDelete: Restrict)
  recordedBy  User?          @relation("ClearanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  revokedBy   User?          @relation("ClearanceRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([competitionId])
  @@map("medical_clearance")
}

// ============================================================
// Уведомления (DATABASE.md, 3.8; Phase 4b): шаблоны — в репозитории (web — в приложении, письма — в worker),
// в `params` — только идентификаторы и коды.
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
  MAX
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String
  params        Json
  competitionId String?   @map("competition_id") @db.Uuid
  sourceEventId String?   @map("source_event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([sourceEventId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}

model NotificationDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  lastErrorCode     String?             @map("last_error_code")
  providerMessageId String?             @map("provider_message_id")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, channel])
  @@map("notification_delivery")
}

/// Настройка канала для типа уведомления; строки нет — действует значение по умолчанию (включено).
model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  type      String
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preference")
}

// ============================================================
// Жеребьёвка, сетки, схватки сеток (DATABASE.md, 3.6; ARCHITECTURE.md, 14.4–14.5, 16.5; ADR-11; Phase 5a)
// Операционные таблицы турнира: пишутся в журнал синхронизации триггерами и несут competition_id.
// Опубликованная жеребьёвка и её слоты неизменяемы (триггеры); меняется только статус на SUPERSEDED.
// Состояние схватки, события и результат — Phase 7; ковёр и расписание — Phase 6.
// ============================================================

enum DrawStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum BracketKind {
  MAIN
  POOL
  REPECHAGE
  FINAL
  PLAYOFF
}

enum SlotSource {
  DRAW_SLOT
  WINNER_OF
  LOSER_OF
  POOL_RANK
  DYNAMIC
}

enum Side {
  RED
  BLUE
}

enum MatchStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  PAUSED
  FINISHED
  POSTPONED
  CANCELLED
}

/// Тип события журнала схватки (ARCHITECTURE.md, 14.6). Отмена — компенсирующее событие EVENT_VOIDED.
enum MatchEventType {
  CLOCK_STARTED
  CLOCK_STOPPED
  SCORE
  HOLD_STARTED
  HOLD_ENDED
  PENALTY
  EVENT_VOIDED
}

/// Результат схватки: предварительный (бригада) → подтверждённый (руководитель ковра, главный судья);
/// PUBLISHED и AMENDED — Phase 7b.
enum MatchResultStatus {
  PROVISIONAL
  CONFIRMED
  PUBLISHED
  AMENDED
}

enum WinMethod {
  TOTAL_VICTORY
  SUPERIORITY
  POINTS
  DECISION
  NO_SHOW
  WITHDRAWAL
  INJURY
  DISQUALIFICATION
  BYE
}

/// Версия жеребьёвки категории (ADR-11): вход, seed и версия алгоритма — всё, чтобы повторить результат.
/// `number` — номер версии в категории; `version` — оптимистическая блокировка (If-Match).
model Draw {
  id               String                @id @default(uuid(7)) @db.Uuid
  competitionId    String                @map("competition_id") @db.Uuid
  categoryId       String                @map("category_id") @db.Uuid
  number           Int
  status           DrawStatus            @default(DRAFT)
  format           CompetitionFormatCode
  algorithmVersion String                @map("algorithm_version")
  randomSeed       String                @map("random_seed")
  /// seed задан вручную, а не создан сервером: показывается рядом с версией для прозрачности.
  manualSeed       Boolean               @default(false) @map("manual_seed")
  inputHash        String                @map("input_hash")
  /// Канонический вход (DrawInput): только идентификаторы и номера посева.
  input            Json
  separationReport Json                  @map("separation_report")
  version          Int                   @default(1)
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedById    String?               @map("published_by_id") @db.Uuid
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(3)
  supersededById   String?               @map("superseded_by_id") @db.Uuid
  supersededAt     DateTime?             @map("superseded_at") @db.Timestamptz(3)
  supersedeReason  String?               @map("supersede_reason")
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition  Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category     CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("DrawCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy  User?               @relation("DrawPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  supersededBy User?               @relation("DrawSuperseder", fields: [supersededById], references: [id], onDelete: Restrict)
  slots        DrawSlot[]
  brackets     Bracket[]

  @@unique([categoryId, number])
  @@index([competitionId, status])
  @@map("draw")
}

/// Позиция жеребьёвки: участие или BYE (entryId пуст).
model DrawSlot {
  id            String  @id @default(uuid(7)) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  drawId        String  @map("draw_id") @db.Uuid
  position      Int
  entryId       String? @map("entry_id") @db.Uuid
  seedNumber    Int?    @map("seed_number")
  /// Подгруппа A или B (выбывание с утешительными), иначе пусто.
  pool          String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  draw        Draw        @relation(fields: [drawId], references: [id], onDelete: Restrict)
  entry       Entry?      @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([drawId, position])
  @@map("draw_slot")
}

/// Этап сетки опубликованной жеребьёвки: основная сетка, утешительные схватки, круговая группа.
model Bracket {
  id            String                @id @default(uuid(7)) @db.Uuid
  competitionId String                @map("competition_id") @db.Uuid
  categoryId    String                @map("category_id") @db.Uuid
  drawId        String                @map("draw_id") @db.Uuid
  kind          BracketKind
  format        CompetitionFormatCode
  stageOrder    Int                   @map("stage_order")
  label         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  competition Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category    CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  draw        Draw                @relation(fields: [drawId], references: [id], onDelete: Restrict)
  nodes       BracketNode[]

  @@unique([drawId, stageOrder])
  @@index([categoryId])
  @@map("bracket")
}

/// Узел сетки: источники сторон (позиция жеребьёвки, победитель или проигравший узла, правило формата),
/// статические переходы и места. Играется одной схваткой (Match.bracketNodeId).
model BracketNode {
  id             String     @id @default(uuid(7)) @db.Uuid
  competitionId  String     @map("competition_id") @db.Uuid
  bracketId      String     @map("bracket_id") @db.Uuid
  /// Устойчивый ключ узла в сетке: MAIN:2:1, REPECHAGE:A:1, POOL:3:2.
  key            String
  round          Int
  position       Int
  label          String
  redSource      SlotSource @map("red_source")
  redSourceRef   String     @map("red_source_ref")
  blueSource     SlotSource @map("blue_source")
  blueSourceRef  String     @map("blue_source_ref")
  winnerToNodeId String?    @map("winner_to_node_id") @db.Uuid
  winnerToSide   Side?      @map("winner_to_side")
  loserToNodeId  String?    @map("loser_to_node_id") @db.Uuid
  loserToSide    Side?      @map("loser_to_side")
  placeForWinner Int?       @map("place_for_winner")
  placeForLoser  Int?       @map("place_for_loser")

  bracket     Bracket       @relation(fields: [bracketId], references: [id], onDelete: Restrict)
  winnerTo    BracketNode?  @relation("NodeWinnerTo", fields: [winnerToNodeId], references: [id], onDelete: Restrict)
  winnerFrom  BracketNode[] @relation("NodeWinnerTo")
  loserTo     BracketNode?  @relation("NodeLoserTo", fields: [loserToNodeId], references: [id], onDelete: Restrict)
  loserFrom   BracketNode[] @relation("NodeLoserTo")
  match       Match?
  competition Competition   @relation(fields: [competitionId], references: [id])

  @@unique([bracketId, round, position])
  @@unique([bracketId, key])
  @@map("bracket_node")
}

/// Схватка сетки. Номер — сквозной в турнире; у схватки без соперника (BYE) номера нет, она завершается
/// системой при публикации или продвижении. Ковёр, время, состояние и результат — Phase 6–7.
model Match {
  id              String      @id @default(uuid(7)) @db.Uuid
  competitionId   String      @map("competition_id") @db.Uuid
  categoryId      String      @map("category_id") @db.Uuid
  bracketNodeId   String?     @unique @map("bracket_node_id") @db.Uuid
  publicId        String      @unique @map("public_id")
  matchNumber     Int?        @map("match_number")
  roundLabel      String      @map("round_label")
  status          MatchStatus @default(SCHEDULED)
  durationSeconds Int?        @map("duration_seconds")
  /// Победитель подтверждённого результата (или без схватки — BYE); у предварительного — пусто.
  winnerSide      Side?       @map("winner_side")
  /// Фактический ковёр (Phase 7a): ковёр расписания на момент старта.
  matId           String?     @map("mat_id") @db.Uuid
  /// Проекция счёта по журналу (MatchState из packages/contracts): пересчитывается с каждым событием.
  state           Json?
  /// Номер последнего события журнала; команда со старым expectedSeq получает конфликт.
  stateSeq        Int         @default(0) @map("state_seq")
  readyAt         DateTime?   @map("ready_at") @db.Timestamptz(3)
  startedAt       DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category      CompetitionCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bracketNode   BracketNode?          @relation(fields: [bracketNodeId], references: [id], onDelete: Restrict)
  mat           Mat?                  @relation(fields: [matId], references: [id], onDelete: Restrict)
  participants  MatchParticipant[]
  schedule      MatchSchedule?
  events        MatchEvent[]
  result        MatchResult?
  activeEntries Entry[]               @relation("EntryActiveMatch")
  revisions     MatchResultRevision[]
  incidents     MedicalIncident[]

  @@unique([competitionId, matchNumber])
  @@index([competitionId, status])
  @@index([categoryId, status])
  @@index([matId, status])
  @@map("match")
}

/// Журнал событий схватки (ARCHITECTURE.md, 14.6; ADR-06): только дополняется — у роли приложения нет UPDATE и
/// DELETE. Порядок — unique (matchId, seq), повтор команды — unique (matchId, idempotencyKey).
model MatchEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  competitionId  String         @map("competition_id") @db.Uuid
  matchId        String         @map("match_id") @db.Uuid
  seq            Int
  type           MatchEventType
  side           Side?
  /// Код действия или наказания из правил турнира.
  actionCode     String?        @map("action_code")
  /// HOLD_ENDED — длительность удержания, мс.
  value          Int?
  /// Показание основного секундомера на устройстве (R-09), мс.
  matchClockMs   Int            @map("match_clock_ms")
  deviceTime     DateTime       @map("device_time") @db.Timestamptz(3)
  serverTime     DateTime       @default(now()) @map("server_time") @db.Timestamptz(3)
  voidsEventId   String?        @map("voids_event_id") @db.Uuid
  idempotencyKey String         @map("idempotency_key") @db.Uuid
  recordedById   String?        @map("recorded_by_id") @db.Uuid
  deviceId       String?        @map("device_id")
  /// Причина отмены и т. п.; без ПДн.
  payload        Json?

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  voids       MatchEvent?  @relation("MatchEventVoids", fields: [voidsEventId], references: [id], onDelete: Restrict)
  voidedBy    MatchEvent[] @relation("MatchEventVoids")
  recordedBy  User?        @relation("MatchEventRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([matchId, seq])
  @@unique([matchId, idempotencyKey])
  @@map("match_event")
}

/// Результат схватки (ARCHITECTURE.md, 16.6): предварительный вносит бригада ковра, подтверждает руководитель
/// ковра или главный судья. Исходы без судьи (BYE, неявка снятого участника) подтверждает система.
model MatchResult {
  id            String            @id @default(uuid(7)) @db.Uuid
  competitionId String            @map("competition_id") @db.Uuid
  matchId       String            @unique @map("match_id") @db.Uuid
  status        MatchResultStatus @default(PROVISIONAL)
  /// Пусто — неявка обоих: оба проигравшие.
  winnerSide    Side?             @map("winner_side")
  method        WinMethod
  methodDetail  String?           @map("method_detail")
  redScore      Int?              @map("red_score")
  blueScore     Int?              @map("blue_score")
  durationMs    Int?              @map("duration_ms")
  basedOnSeq    Int?              @map("based_on_seq")
  reason        String?
  proposedById  String?           @map("proposed_by_id") @db.Uuid
  proposedAt    DateTime?         @map("proposed_at") @db.Timestamptz(3)
  confirmedById String?           @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  revision      Int               @default(1)
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  match       Match                 @relation(fields: [matchId], references: [id], onDelete: Restrict)
  proposedBy  User?                 @relation("MatchResultProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  confirmedBy User?                 @relation("MatchResultConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  revisions   MatchResultRevision[]

  @@index([competitionId, status])
  @@map("match_result")
}

/// Прежние варианты подтверждённого результата (Phase 7b, `result.amend`): снимок варианта `revision`, причина
/// изменения, кто и когда изменил. Только дополняется — у роли приложения нет UPDATE и DELETE.
model MatchResultRevision {
  id            String            @id @default(uuid(7)) @db.Uuid
  competitionId String            @map("competition_id") @db.Uuid
  matchResultId String            @map("match_result_id") @db.Uuid
  matchId       String            @map("match_id") @db.Uuid
  /// Номер прежнего варианта (1 — первоначальный подтверждённый результат).
  revision      Int
  status        MatchResultStatus
  winnerSide    Side?             @map("winner_side")
  method        WinMethod
  methodDetail  String?           @map("method_detail")
  redScore      Int?              @map("red_score")
  blueScore     Int?              @map("blue_score")
  confirmedById String?           @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  /// Причина изменения (почему этот вариант заменён).
  reason        String
  changedById   String            @map("changed_by_id") @db.Uuid
  changedAt     DateTime          @default(now()) @map("changed_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Restrict)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  changedBy   User        @relation("MatchResultReviser", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([matchResultId, revision])
  @@index([matchId])
  @@map("match_result_revision")
}

enum CategoryResultStatus {
  PROVISIONAL
  PUBLISHED
  AMENDED
}

enum Medal {
  GOLD
  SILVER
  BRONZE
}

/// Итоги категории (Phase 7b): места и медали завершённой сетки. Считаются при завершении категории и при
/// изменении подтверждённого результата; публикация — `result.publish`.
model CategoryResult {
  id            String               @id @default(uuid(7)) @db.Uuid
  competitionId String               @map("competition_id") @db.Uuid
  categoryId    String               @unique @map("category_id") @db.Uuid
  drawId        String               @map("draw_id") @db.Uuid
  status        CategoryResultStatus @default(PROVISIONAL)
  computedAt    DateTime             @map("computed_at") @db.Timestamptz(3)
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(3)
  publishedById String?              @map("published_by_id") @db.Uuid
  amendedAt     DateTime?            @map("amended_at") @db.Timestamptz(3)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition    Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category       CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  publishedBy    User?               @relation("CategoryResultPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  placements     Placement[]
  athleteResults AthleteResult[]

  @@index([competitionId, status])
  @@map("category_result")
}

/// Место участника в итогах категории: место (делится: 3, 3, 5, 5), медаль за 1–3 места, победы и поражения
/// (схватки без соперника не считаются).
model Placement {
  id               String @id @default(uuid(7)) @db.Uuid
  competitionId    String @map("competition_id") @db.Uuid
  categoryResultId String @map("category_result_id") @db.Uuid
  entryId          String @map("entry_id") @db.Uuid
  place            Int
  medal            Medal?
  wins             Int    @default(0)
  losses           Int    @default(0)

  competition    Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  categoryResult CategoryResult @relation(fields: [categoryResultId], references: [id], onDelete: Cascade)
  entry          Entry          @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([categoryResultId, entryId])
  @@index([entryId])
  @@map("placement")
}

/// История спортсмена (Phase 7b): опубликованное место участия со снимком турнира и категории — переживает
/// переименования; обновляется при изменении результата после публикации.
model AthleteResult {
  id                   String               @id @default(uuid(7)) @db.Uuid
  athleteId            String               @map("athlete_id") @db.Uuid
  entryId              String               @unique @map("entry_id") @db.Uuid
  competitionId        String               @map("competition_id") @db.Uuid
  categoryId           String               @map("category_id") @db.Uuid
  categoryResultId     String               @map("category_result_id") @db.Uuid
  competitionName      String               @map("competition_name")
  competitionStartDate DateTime             @map("competition_start_date") @db.Date
  competitionEndDate   DateTime             @map("competition_end_date") @db.Date
  competitionLevel     CompetitionLevel     @map("competition_level")
  categoryNameRu       String               @map("category_name_ru")
  categoryNameEn       String               @map("category_name_en")
  clubName             String?              @map("club_name")
  place                Int
  medal                Medal?
  wins                 Int                  @default(0)
  losses               Int                  @default(0)
  status               CategoryResultStatus
  publishedAt          DateTime             @map("published_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  athlete        AthleteProfile      @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  entry          Entry               @relation(fields: [entryId], references: [id], onDelete: Restrict)
  competition    Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category       CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryResult CategoryResult      @relation(fields: [categoryResultId], references: [id], onDelete: Restrict)

  @@index([athleteId, competitionStartDate(sort: Desc)])
  @@index([competitionId])
  @@map("athlete_result")
}

enum MedicalIncidentKind {
  ASSISTANCE
  STOPPAGE
}

enum MedicalIncidentDecision {
  CONTINUE
  WITHDRAWN_BY_DOCTOR
}

/// Врач на ковре (G-05, часть 2; Phase 7b): помощь или остановка схватки и решение врача. Без диагнозов; заметка
/// видна только медицинскому персоналу, её чтение — в журнал доступа.
model MedicalIncident {
  id            String                  @id @default(uuid(7)) @db.Uuid
  competitionId String                  @map("competition_id") @db.Uuid
  matchId       String                  @map("match_id") @db.Uuid
  entryId       String                  @map("entry_id") @db.Uuid
  side          Side
  kind          MedicalIncidentKind
  decision      MedicalIncidentDecision
  matchClockMs  Int?                    @map("match_clock_ms")
  note          String?
  recordedById  String                  @map("recorded_by_id") @db.Uuid
  recordedAt    DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  entry       Entry       @relation(fields: [entryId], references: [id], onDelete: Restrict)
  recordedBy  User        @relation("MedicalIncidentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([entryId])
  @@map("medical_incident")
}

/// Сторона схватки: участие (пусто, пока не известно) или BYE — не одновременно (CHECK).
model MatchParticipant {
  id            String  @id @default(uuid(7)) @db.Uuid
  competitionId String  @map("competition_id") @db.Uuid
  matchId       String  @map("match_id") @db.Uuid
  side          Side
  entryId       String? @map("entry_id") @db.Uuid
  isBye         Boolean @default(false) @map("is_bye")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  entry       Entry?      @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([matchId, side])
  @@index([entryId])
  @@map("match_participant")
}

// ============================================================
// Расписание (DATABASE.md, 3.7 — Phase 6; ARCHITECTURE.md, 14.6, 16.6): ковры, сессии, автопланировщик и его
// результат, ручная правка, судейские бригады. Закрепление категорий за коврами — параметр запроса генерации,
// не хранится отдельно: расстановка видна по мату уже стоящих схваток категории.
// ============================================================

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

/// Должность в судейской бригаде ковра (D-07).
enum MatCrewRole {
  MAT_CHIEF
  REFEREE
  SIDE_JUDGE
  TECHNICAL_SECRETARY
  SCOREBOARD_OPERATOR
  TIMEKEEPER
}

/// Ковёр турнира.
model Mat {
  id            String   @id @default(uuid(7)) @db.Uuid
  competitionId String   @map("competition_id") @db.Uuid
  number        Int
  name          String?
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  items       MatchSchedule[]
  assignments MatAssignment[]
  matches     Match[]

  @@unique([competitionId, number])
  @@map("mat")
}

/// Сессия турнирного дня («Утро», «Финалы»): начало и конец во времени турнира. Сессии одного дня не
/// пересекаются — проверяется в сервисе (без EXCLUDE-ограничения, чтобы не заводить btree_gist).
model Session {
  id            String   @id @default(uuid(7)) @db.Uuid
  competitionId String   @map("competition_id") @db.Uuid
  name          String
  startsAt      DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(3)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  items       MatchSchedule[]
  assignments MatAssignment[]

  @@index([competitionId, startsAt])
  @@map("session")
}

/// Расписание турнира — одна строка на турнир: статус, версия (If-Match), время смены пары между схватками,
/// кто и когда опубликовал. Создаётся лениво при первом обращении к разделу «Расписание».
model Schedule {
  id                   String         @id @default(uuid(7)) @db.Uuid
  competitionId        String         @unique @map("competition_id") @db.Uuid
  status               ScheduleStatus @default(DRAFT)
  matChangeoverSeconds Int            @default(60) @map("mat_changeover_seconds")
  version              Int            @default(1)
  publishedById        String?        @map("published_by_id") @db.Uuid
  publishedAt          DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  publishedBy User?       @relation("SchedulePublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@map("schedule")
}

/// Место схватки в расписании: сессия, ковёр, порядок на ковре (в пределах сессии), плановое время и признак
/// «закреплена» (генерация не трогает). Удаляется вместе со схваткой (onDelete: Cascade на match — единственное
/// исключение из Restrict в этой схеме: раздел 53 требует, чтобы место в расписании не переживало свою схватку).
/// Порядок на ковре — unique(session, mat, orderInMat) DEFERRABLE (миграция, раздел «Частичные и отложенные
/// ограничения»): перестановки внутри пакета правки идут одной транзакцией без промежуточного конфликта.
model MatchSchedule {
  id            String   @id @default(uuid(7)) @db.Uuid
  competitionId String   @map("competition_id") @db.Uuid
  matchId       String   @unique @map("match_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  matId         String   @map("mat_id") @db.Uuid
  orderInMat    Int      @map("order_in_mat")
  plannedAt     DateTime @map("planned_at") @db.Timestamptz(3)
  locked        Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  mat         Mat         @relation(fields: [matId], references: [id], onDelete: Restrict)

  @@index([sessionId, matId, orderInMat])
  @@index([competitionId])
  @@map("match_schedule")
}

/// Назначение персонала турнира на должность в бригаде ковра сессии (D-07). Один человек в одну сессию — на
/// одном ковре (проверяется в сервисе: не выражается простым unique).
model MatAssignment {
  id            String      @id @default(uuid(7)) @db.Uuid
  competitionId String      @map("competition_id") @db.Uuid
  sessionId     String      @map("session_id") @db.Uuid
  matId         String      @map("mat_id") @db.Uuid
  role          MatCrewRole
  userId        String      @map("user_id") @db.Uuid
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  mat         Mat         @relation(fields: [matId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sessionId, matId, role])
  @@index([sessionId, userId])
  @@map("mat_assignment")
}
