# SAMBO DIGITAL ECOSYSTEM — переменные окружения (раздел 49 ТЗ; SECURITY.md, 8).
# Скопируйте в .env и заполните. Файл .env в git не попадает. Все значения ниже — для локальной разработки.
# Приложение проверяет окружение при старте (packages/server-kit/src/env.ts) и не запускается с неверной конфигурацией.

# ---- Общие ----
NODE_ENV=development
# cloud | venue-node (площадочный узел, Phase 9.5)
DEPLOYMENT_MODE=cloud
# Идентификатор площадочного узла, только при DEPLOYMENT_MODE=venue-node
NODE_ID=
LOG_LEVEL=info

# ---- Веб и API ----
# Публичный адрес веб-приложения: из него строятся ссылки в письмах
APP_URL=http://localhost:3000
API_PORT=4000
# Адрес API для server-side запросов и rewrites Next.js
API_INTERNAL_URL=http://localhost:4000
# Разрешённые origin для CORS (через запятую). Веб ходит через rewrites Next.js и CORS не требует
CORS_ORIGINS=
# За reverse proxy — true (корректный IP клиента для rate limit и аудита)
TRUST_PROXY=false
# Secure-cookie. В production — только true; локально по http — false
COOKIE_SECURE=false

# ---- PostgreSQL ----
# Роль приложения: DML без DDL, без UPDATE/DELETE на журналах (DATABASE.md, 10)
DATABASE_URL=postgresql://sde_app:sde_dev_app@localhost:5432/sde
# Владелец схемы: только для миграций
DATABASE_ADMIN_URL=postgresql://sde:sde_dev_owner@localhost:5432/sde

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Секреты (минимум 32 символа; сгенерируйте: openssl rand -base64 48) ----
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_KID=k1
# Предыдущий ключ на время ротации (оба заполняются вместе)
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=
# CSRF, подпись QR, шифрование секретов в outbox
AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef
# 32 байта в base64 (openssl rand -base64 32): шифрование секретов TOTP
TOTP_ENCRYPTION_KEY=ZGV2LXRvdHAta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=

# ---- S3-совместимое хранилище (российский провайдер в production; MinIO локально) ----
STORAGE_ENDPOINT=http://localhost:9000
# Адрес хранилища, доступный браузеру (presigned-ссылки); по умолчанию = STORAGE_ENDPOINT
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=ru-central1
STORAGE_ACCESS_KEY=sde-dev
STORAGE_SECRET_KEY=sde-dev-secret
STORAGE_BUCKET_PUBLIC=sde-public-media
STORAGE_BUCKET_PRIVATE=sde-private-documents
STORAGE_BUCKET_GENERATED=sde-generated
# Публичный адрес bucket публичных медиа (CDN в production)
STORAGE_PUBLIC_URL=http://localhost:9000/sde-public-media
STORAGE_FORCE_PATH_STYLE=true

# ---- Email ----
# smtp | log (log — только разработка и тесты: письма пишутся в лог worker без ссылок)
EMAIL_PROVIDER=smtp
EMAIL_FROM="SAMBO Digital <no-reply@sambo.local>"
# Локально — Mailpit (docker compose): веб-интерфейс http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Прочее ----
RATE_LIMIT_ENABLED=true

# ---- Phase 10: мессенджеры (необязательны до включения каналов) ----
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# ---- Seed (только разработка): вымышленные учётные записи ----
SEED_PASSWORD="Sambo-Dev-2026!"
# Секрет TOTP администратора из seed (base32). Код для входа: любое приложение-аутентификатор
SEED_ADMIN_TOTP_SECRET=KVKFKRCPNZQUYMLXOVYDSQKJKZDTSRLD

# ---- Worker ----
# Порт проверки живости worker (/health)
WORKER_PORT=4100

# ---- Web ----
# Origin хранилища для загрузки файлов из браузера (CSP connect-src и img-src)
STORAGE_UPLOAD_ORIGIN=http://localhost:9000
