{
  "name": "@sde/api",
  "version": "0.3.0",
  "private": true,
  "description": "Backend: модульный монолит NestJS (REST)",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-presigned-post": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@sde/contracts": "workspace:*",
    "@sde/db": "workspace:*",
    "@sde/server-kit": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
