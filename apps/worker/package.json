{
  "name": "@sde/worker",
  "version": "0.2.0",
  "private": true,
  "description": "Фоновые задачи: диспетчер outbox, доставка писем, обслуживание БД",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@sde/contracts": "workspace:*",
    "@sde/db": "workspace:*",
    "@sde/server-kit": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nodemailer": "9.1.1",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@types/nodemailer": "7.0.12",
    "vitest": "3.2.7"
  }
}
